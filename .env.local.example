# Copy to .env.local and fill in from your Azure App Registration.
MS_CLIENT_ID=your-application-client-id
MS_CLIENT_SECRET=your-client-secret-value
# Use "common" for any account, or your directory (tenant) ID.
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# OpenRouter — get a free key at https://openrouter.ai/keys
# Used for all extraction models (Gemini 2.5 Flash, Qwen 2.5 VL, etc.)
OPENROUTER_API_KEY=your-openrouter-api-key
